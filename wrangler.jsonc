{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mocha-med-log",
  "account_id": "83170f7d4c8d2e8904d8d3f417726504",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mocha_med_log",
      "database_id": "b0111dd4-ec0f-4feb-863f-870bf0619a60"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_IP", "namespace_id": "6001", "simple": { "limit": 8, "period": 60 } },
    { "name": "LOGIN_ALL", "namespace_id": "6002", "simple": { "limit": 40, "period": 60 } }
  ],
  "routes": [
    {
      "pattern": "mocha-med-log.ipluto.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "REMINDER_INTERVAL_MINUTES": "5",
    "REMINDER_WINDOW_HOURS": "1"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
