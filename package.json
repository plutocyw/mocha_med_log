{
  "name": "mocha-med-log",
  "version": "0.1.0",
  "private": true,
  "description": "PWA for tracking Mocha's medication schedule with Cloudflare Workers, D1, and Web Push reminders.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mocha_med_log --local",
    "db:migrate:remote": "wrangler d1 migrations apply mocha_med_log --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260609.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.98.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.4.1"
  }
}
